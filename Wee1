#include <iostream>
using namespace std;

struct DNode {
    int data;
    DNode *prev, *next;
    DNode(int val) : data(val), prev(nullptr), next(nullptr) {}
};

int getSize(DNode* head) {
    int cnt = 0;
    for (DNode* cur = head; cur; cur = cur->next) cnt++;
    return cnt;
}

// 1. Thêm vào đầu
void insertFirst(DNode* &head, int x) {
    DNode* p = new DNode(x);
    p->next = head;
    if (head) head->prev = p;
    head = p;
}

// 2. Thêm vào cuối
void insertLast(DNode* &head, int x) {
    if (!head) { insertFirst(head, x); return; }
    DNode* cur = head;
    while (cur->next) cur = cur->next;
    DNode* p = new DNode(x);
    cur->next = p;
    p->prev = cur;
}

// 3. Thêm vào vị trí k 
void insertMiddle(DNode* &head, int x, int k) {
    int n = getSize(head);
    if (k < 1 || k > n + 1) return;
    if (k == 1) { insertFirst(head, x); return; }
    if (k == n + 1) { insertLast(head, x); return; }

    DNode* cur = head;
    for (int i = 1; i < k - 1; i++) cur = cur->next;

    DNode* p = new DNode(x);
    p->next = cur->next;
    p->prev = cur;
    cur->next->prev = p;
    cur->next = p;
}

// 4. Xóa phần tử đầu
void deleteFirst(DNode* &head) {
    if (!head) return;
    DNode* tmp = head;
    head = head->next;
    if (head) head->prev = nullptr;
    delete tmp;
}

// 5. Xóa phần tử cuối
void deleteLast(DNode* &head) {
    if (!head || !head->next) { deleteFirst(head); return; }
    DNode* cur = head;
    while (cur->next) cur = cur->next;
    cur->prev->next = nullptr;
    delete cur;
}

// 6. Xóa tại vị trí k 
void deleteMiddle(DNode* &head, int k) {
    int n = getSize(head);
    if (k < 1 || k > n) return;
    if (k == 1) { deleteFirst(head); return; }
    if (k == n) { deleteLast(head); return; }

    DNode* cur = head;
    for (int i = 1; i < k; i++) cur = cur->next;

    cur->prev->next = cur->next;
    cur->next->prev = cur->prev;
    delete cur;
}

// 7. In xuôi
void inXuoi(DNode* head) {
    for (DNode* cur = head; cur; cur = cur->next) cout << cur->data << " ";
    cout << "\n";
}

// 8. In ngược
void inNguoc(DNode* head) {
    if (!head) return;
    DNode* cur = head;
    while (cur->next) cur = cur->next;
    for (; cur; cur = cur->prev) cout << cur->data << " ";
    cout << "\n";
}

int main() {
    DNode* head = nullptr;

    insertFirst(head, 30);
    insertFirst(head, 10);
    insertLast(head, 50);          
    insertMiddle(head, 20, 2);     
    insertMiddle(head, 40, 4);     

    cout << "Danh sach in xuoi: ";
    inXuoi(head);

    cout << "Danh sach in nguoc: ";
    inNguoc(head);

    deleteMiddle(head, 3);         
    cout << "Sau khi xoa vi tri 3: ";
    inXuoi(head);

    return 0;
}
